# Brique 3 — Outreach Generator
# Aucun envoi automatique. Toutes les sorties exigent une validation humaine.

# Fournisseur IA (optionnel) : openai | anthropic
AI_PROVIDER=openai

# Activation IA (false = templates sans IA uniquement)
ENABLE_AI_OUTREACH=false

# Clés API (laissez vide pour fallback templates)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modèle (optionnel) — ex. gpt-4o-mini, claude-sonnet-4-6
AI_MODEL=

# Réglages par défaut
DEFAULT_OUTREACH_TONE=premium_sobre
DEFAULT_HUMAN_REVIEW_REQUIRED=true
