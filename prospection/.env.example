# =============================================
# Brique 2 - Module d'enrichissement de leads
# =============================================
# Copier ce fichier en .env puis renseigner les clés nécessaires.
# Aucune clé n'est strictement obligatoire : le module fonctionne en mode fallback sans IA et sans Pappers.

# --- IA (optionnel) ---
# AI_PROVIDER au choix : "openai" | "anthropic"
AI_PROVIDER=openai
ENABLE_AI_ENRICHMENT=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Pappers (enrichissement B2B agences) ---
ENABLE_PAPPERS_ENRICHMENT=false
PAPPERS_API_KEY=
PAPPERS_API_BASE=https://api.pappers.fr/v2

# --- Airtable (export) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# --- Comportement ---
# Forcer la revue humaine sur tous les leads avant toute action commerciale
HUMAN_REVIEW_REQUIRED_DEFAULT=true
# Délai entre 2 appels API IA (ms) pour rester soft
AI_RATE_LIMIT_MS=350
# Activer logs verbeux
VERBOSE=false
